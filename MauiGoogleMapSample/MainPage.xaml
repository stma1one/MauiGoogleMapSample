<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiGoogleMapSample.ViewModels"
             x:Class="MauiGoogleMapSample.MainPage"
             x:DataType="vm:SetupStatusViewModel"
             FlowDirection="RightToLeft"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="☕ CoffeeMap — מפת תחנות קפה"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Start" />

            <Label Text="שלב 1: הגדרת NuGet, אתחול UseMauiMaps(), הרשאות Android ושמירת מפתח מוצפן"
                   FontSize="15"
                   TextColor="{StaticResource Gray600}" />

            <!-- Setup Checklist Card -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray300}"
                    Padding="16"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="רשימת בדיקה לתשתית המפות:"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="✅ חבילת Microsoft.Maui.Controls.Maps מותקנת" FontSize="14" />
                    <Label Text="✅ קריאה ל-UseMauiMaps() ו-Fluent DI ב-MauiProgram.cs" FontSize="14" />
                    <Label Text="✅ הרשאות ACCESS_FINE_LOCATION ו-ACCESS_COARSE_LOCATION ב-AndroidManifest.xml" FontSize="14" />
                    <Label Text="🔐 שמירת מפתח API באחסון המוצפן (SecureStorage) — ללא חשיפה בקוד" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Interactive API Key Validator & SecureStorage -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray300}"
                    Padding="16"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="אימות ושמירת Google Maps API Key (SecureStorage):"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Entry AutomationId="ApiKeyEntry"
                           Placeholder="הזן מפתח API לבדיקה ושמירה..."
                           Text="{Binding ApiKeyInput}"
                           FlowDirection="LeftToRight" />

                    <HorizontalStackLayout Spacing="8">
                        <Button AutomationId="ValidateKeyButton"
                                Text="בדוק תקינות"
                                Command="{Binding ValidateKeyCommand}" />
                        <Button AutomationId="SaveKeyButton"
                                Text="שמור מוצפן"
                                Command="{Binding SaveKeyCommand}" />
                        <Button AutomationId="ClearKeyButton"
                                Text="מחק / אפס"
                                Command="{Binding ClearSavedKeyCommand}"
                                BackgroundColor="{StaticResource Gray500}" />
                    </HorizontalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}" />

                    <Border StrokeShape="RoundRectangle 8"
                            Padding="12"
                            BackgroundColor="{StaticResource Gray100}">
                        <VerticalStackLayout Spacing="4">
                            <Label AutomationId="StatusTitleLabel"
                                   Text="{Binding StatusTitle}"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label AutomationId="StatusDetailsLabel"
                                   Text="{Binding StatusDetails}"
                                   FontSize="13" />
                            <Label AutomationId="StorageStatusLabel"
                                   Text="{Binding StorageStatus}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
