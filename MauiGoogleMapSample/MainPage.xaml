<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiGoogleMapSample.ViewModels"
             x:Class="MauiGoogleMapSample.MainPage"
             x:DataType="vm:SetupStatusViewModel"
             FlowDirection="RightToLeft"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="☕ CoffeeMap — מפת תחנות קפה"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Start" />

            <Label Text="שלב 1: הגדרת NuGet, אתחול UseMauiMaps(), הרשאות Android והזרקת מפתח מ-Secrets.props"
                   FontSize="15"
                   TextColor="{StaticResource Gray600}" />

            <!-- Setup Checklist Card -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray300}"
                    Padding="16"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="רשימת בדיקה לתשתית המפות:"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="✅ חבילת Microsoft.Maui.Controls.Maps מותקנת" FontSize="14" />
                    <Label Text="✅ קריאה ל-UseMauiMaps() ו-Fluent DI ב-MauiProgram.cs" FontSize="14" />
                    <Label Text="✅ הרשאות ACCESS_FINE_LOCATION ו-ACCESS_COARSE_LOCATION ב-AndroidManifest.xml" FontSize="14" />
                    <Label Text="🔑 הזרקת com.google.android.geo.API_KEY מקובץ מקומי Secrets.props (חסום ב-.gitignore)" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Interactive API Key Format Validator -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{StaticResource Gray300}"
                    Padding="16"
                    BackgroundColor="{StaticResource White}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="בדיקת תקינות פורמט Google Maps API Key:"
                           FontSize="16"
                           FontAttributes="Bold" />

                    <Entry AutomationId="ApiKeyEntry"
                           Placeholder="הדביקו מפתח API לבדיקת פורמט..."
                           Text="{Binding ApiKeyInput}"
                           FlowDirection="LeftToRight" />

                    <HorizontalStackLayout Spacing="10">
                        <Button AutomationId="ValidateKeyButton"
                                Text="בדוק תקינות מפתח"
                                Command="{Binding ValidateKeyCommand}" />
                        <Button AutomationId="ResetKeyButton"
                                Text="איפוס ל-Placeholder"
                                Command="{Binding ResetToPlaceholderCommand}"
                                BackgroundColor="{StaticResource Gray500}" />
                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 8"
                            Padding="12"
                            BackgroundColor="{StaticResource Gray100}">
                        <VerticalStackLayout Spacing="4">
                            <Label AutomationId="StatusTitleLabel"
                                   Text="{Binding StatusTitle}"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                            <Label AutomationId="StatusDetailsLabel"
                                   Text="{Binding StatusDetails}"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
