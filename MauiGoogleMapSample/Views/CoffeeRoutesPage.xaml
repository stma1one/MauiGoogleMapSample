<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
             xmlns:models="clr-namespace:MauiGoogleMapSample.Models"
             xmlns:vm="clr-namespace:MauiGoogleMapSample.ViewModels"
             x:Class="MauiGoogleMapSample.Views.CoffeeRoutesPage"
             x:DataType="vm:CoffeeRoutesViewModel"
             FlowDirection="RightToLeft"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Padding="12">

        <!-- Overlay Controls -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center">
            <Button AutomationId="ToggleRouteButton"
                    Text="מסלול קפה"
                    Command="{Binding ToggleRouteCommand}" />
            <Button AutomationId="ToggleDeliveryZoneButton"
                    Text="אזור משלוח"
                    Command="{Binding ToggleDeliveryZoneCommand}" />
            <Button AutomationId="ClearOverlaysButton"
                    Text="נקה שכבות"
                    Command="{Binding ClearOverlaysCommand}"
                    BackgroundColor="{StaticResource Gray500}" />
        </HorizontalStackLayout>

        <!-- Map with Pins + Polyline/Circle MapElements -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 12"
                Stroke="{StaticResource Gray300}">
            <maps:Map x:Name="RoutesMapControl"
                      AutomationId="RoutesMapControl"
                      ItemsSource="{Binding Stations}"
                      IsScrollEnabled="True"
                      IsZoomEnabled="True">
                <maps:Map.ItemTemplate>
                    <DataTemplate x:DataType="models:CoffeeStation">
                        <maps:Pin Location="{Binding Location}"
                                  Label="{Binding Name}"
                                  Address="{Binding Address}"
                                  Type="Place" />
                    </DataTemplate>
                </maps:Map.ItemTemplate>
            </maps:Map>
        </Border>

        <!-- Route Summary -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 8"
                Padding="12"
                BackgroundColor="{StaticResource Gray100}">
            <Label AutomationId="RouteSummaryLabel"
                   Text="{Binding RouteSummary}"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
        </Border>

    </Grid>
</ContentPage>
