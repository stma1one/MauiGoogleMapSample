<Project>
  <PropertyGroup>
    <!--
      העתיקו קובץ זה באותה תיקייה ושנו את שמו ל-Secrets.props (קובץ זה חסום ב-.gitignore ולא יעלה ל-GitHub).
      הדביקו את מפתח ה-Google Maps API האמיתי שלכם במקום YOUR_GOOGLE_MAPS_API_KEY_HERE.
    -->
    <GoogleMapsApiKey>YOUR_GOOGLE_MAPS_API_KEY_HERE</GoogleMapsApiKey>
  </PropertyGroup>
</Project>
